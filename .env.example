# Supabase
# Les deux premiers noms sont ceux utilisés par l'application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alias acceptés pour garder une configuration simple nommée URL / KEY.
NEXT_PUBLIC_URL=
NEXT_PUBLIC_KEY=

# Exemple Vercel :
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx